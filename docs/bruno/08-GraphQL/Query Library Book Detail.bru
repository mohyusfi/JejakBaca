meta {
  name: Query Library Book Detail
  type: graphql
  seq: 2
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  query LibraryBook($id: Int!) {
    libraryBook(id: $id) {
      id
      title
      author
      isbn
      category
      publishedYear
      stockTotal
      stockAvailable
      description
      coverUrl
    }
  }
}

body:graphql:vars {
  {
    "id": {{bookId}}
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("No GraphQL errors", function() {
    const body = res.getBody();
    expect(body.errors).to.be.undefined;
  });
}
