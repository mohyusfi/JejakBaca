meta {
  name: Query Library Books
  type: graphql
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  query LibraryBooks($page: Int, $limit: Int) {
    libraryBooks(page: $page, limit: $limit) {
      items {
        id
        title
        author
        category
        stockTotal
        stockAvailable
      }
      meta {
        page
        limit
        total
        totalPages
      }
    }
  }
}

body:graphql:vars {
  {
    "page": 1,
    "limit": 10
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("No GraphQL errors", function() {
    const body = res.getBody();
    expect(body.errors).to.be.undefined;
    expect(body.data.libraryBooks.items).to.be.an("array");
  });
}
