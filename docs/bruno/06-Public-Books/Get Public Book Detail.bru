meta {
  name: Get Public Book Detail
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/public-books/:workId
  body: none
  auth: bearer
}

params:path {
  workId: {{workId}}
}

auth:bearer {
  token: {{userToken}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response returns public book detail", function() {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.workId).to.be.a("string");
  });
}
